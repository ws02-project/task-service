NODE_ENV=development
PORT=3000
API_VERSION=v1

# Service Configuration
SERVICE_NAME=task-service
LOG_LEVEL=info

# gRPC Configuration
GRPC_PORT=50052
PROJECT_SERVICE_GRPC_URL=project-service:50051

# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_NAME=taskdb
DB_USER=taskuser
DB_PASSWORD=taskpass
DB_POOL_MIN=2
DB_POOL_MAX=10

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

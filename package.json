{
  "name": "task-service",
  "version": "1.0.0",
  "description": "Production-ready task microservice with TypeScript and MVC pattern",
  "main": "dist/server.js",
  "scripts": {
    "dev": "./scripts/dev.sh",
    "dev:container": "tsx watch --clear-screen=false src/server.ts",
    "dev:build": "docker-compose up --build",
    "dev:local": "tsx watch --clear-screen=false src/server.ts",
    "dev:detached": "docker-compose up -d",
    "dev:logs": "docker-compose logs -f task-service-dev",
    "dev:down": "docker-compose down",
    "dev:clean": "./scripts/clean.sh",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "docker:prod": "docker-compose --profile production up task-service-prod",
    "docker:clean": "docker-compose down -v"
  },
  "keywords": [
    "microservice",
    "nodejs",
    "typescript",
    "mvc"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "express": "^4.18.2",
    "dotenv": "^16.3.1",
    "helmet": "^7.1.0",
    "cors": "^2.8.5",
    "compression": "^1.7.4",
    "express-rate-limit": "^7.1.5",
    "winston": "^3.11.0",
    "joi": "^17.11.0",
    "http-status": "^1.7.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.5",
    "@types/cors": "^2.8.17",
    "@types/compression": "^1.7.5",
    "@types/jest": "^29.5.11",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.0.1",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.1.1",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=8.0.0"
  }
}
